# Decision Bench-specific paths and exceptions
# Local secrets and settings
.env
.env.*
!.env.example
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/review-provider-pr/
.codex/

# Python and tooling
__pycache__/
*.pyc
.venv/
.cache/
.DS_Store
tmp/
*.log

# Local run ledgers and raw provider output (publish finished runs into results/ instead)
runs/

# site/ is build output from `npm run build --prefix web` and `python3 -m decision_bench report`.
# Only the hand-made files below are tracked; a new hand-made file in site/ needs its own ! line.
site/*
!site/analytics.js
!site/apple-touch-icon.png
!site/favicon.svg
!site/icon-*.png
!site/manifest.webmanifest
!site/robots.txt
!site/social-preview.png
!site/assets/
site/assets/*
!site/assets/logos/

# Publish staging directories
results/*/.*.tmp/

# Downloaded third-party source datasets: reproducible from data/sources/manifest.json, not committed.
data/sources/**
!data/sources/manifest.json
!data/sources/README.md
!data/sources/*/
!data/sources/*/LICENSE*

# Internal launch drafts and editorial notes (kept locally, never published)
docs/editorial-skills/
docs/frontier/
docs/social/posts.md
docs/social/x-*.md
docs/social/x-thread.json
docs/social/*.prompt.md
