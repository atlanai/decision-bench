# Copy to .env (ignored by git) and fill in only what you use. Values set in the real environment win.
# Decision Bench never reads OPENAI_API_KEY, ANTHROPIC_API_KEY or any other variable implicitly.

# --- provider "openai-compatible" (OpenAI, OpenRouter, LiteLLM, vLLM, Ollama, ...) ---
# The base URL that /chat/completions and /models are appended to, usually ending in /v1. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:4000/v1        (a local LiteLLM proxy; plain http is allowed only for localhost)
#   http://localhost:8000/v1        (vLLM)
# The URL is never written to run records or results; runs keep only an opaque endpoint id (a hash).
DECISION_BENCH_BASE_URL=

# Bearer key for that endpoint. Optional only for a localhost endpoint.
DECISION_BENCH_API_KEY=

# --- provider "typesafe" (https://api.typesafe.ai) ---
TYPESAFE_API_KEY=

# --- provider "djev" (hosted DiffusionGemma-Jev at https://api.djev.dev) ---
DJEV_API_KEY=

# --- provider "laya" (Jev-compatible System One HTTP API) ---
# Hosted: https://api.impossibl.com/v1 (requires a Laya API key).
# Self-hosted: http://localhost:8000/v1 (key optional unless your server requires one).
LAYA_BASE_URL=
LAYA_API_KEY=

# Providers "claude-cli" and "codex-cli" use the `claude` / `codex` command on your PATH and its own sign-in.
# The keys above are removed from their environment.
