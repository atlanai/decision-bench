{
  "name": "decision-bench-site",
  "private": true,
  "version": "1.0",
  "type": "module",
  "description": "The Decision Bench viewer. Builds into ../site next to the data that `python3 -m decision_bench report` writes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-routes.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:site": "node scripts/check-site.mjs",
    "audit": "lighthouse"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "13.5.0",
    "playwright": "1.58.2",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.0"
  }
}
